# The public address of the site. Facebook and other social platforms need an
# absolute URL for the preview image, so set this once and previews just work.
#
#   Project page : https://<username>.github.io/<repo-name>
#   User page    : https://<username>.github.io
#   Custom domain: https://your-domain.com
#
# The GitHub Actions workflow fills this in automatically on deploy, so you
# only need to edit it if you build and upload the site by hand.
VITE_SITE_URL=https://aj01-a.github.io/digital-world
